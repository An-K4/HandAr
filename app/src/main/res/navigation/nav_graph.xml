<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment android:id="@+id/splashFragment"
        android:name="com.example.handar.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">

        <action android:id="@+id/action_splash_to_welcome"
            app:destination="@+id/welcomeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/languageFragment"
        android:name="com.example.handar.ui.language.LanguageFragment"
        android:label="Chọn ngôn ngữ"
        tools:layout="@layout/fragment_language">
    </fragment>

    <fragment android:id="@+id/onboarding1Fragment"
        android:name="com.example.handar.ui.onboarding.Onboarding1Fragment"
        android:label="Onboarding 1"
        tools:layout="@layout/fragment_onboarding_1">

        <action android:id="@+id/action_onboarding1_to_onboarding2"
            app:destination="@id/onboarding2Fragment"/>

        <action android:id="@+id/action_onboarding1_to_survey"
            app:destination="@id/surveyFragment"
            app:popUpTo="@id/onboarding1Fragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/onboarding2Fragment"
        android:name="com.example.handar.ui.onboarding.Onboarding2Fragment"
        android:label="Onboarding 2"
        tools:layout="@layout/fragment_onboarding_2">

        <action android:id="@+id/action_onboarding2_to_onboarding3"
            app:destination="@id/onboarding3Fragment"/>

        <action android:id="@+id/action_onboarding2_to_survey"
            app:destination="@id/surveyFragment"
            app:popUpTo="@id/onboarding1Fragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/onboarding3Fragment"
        android:name="com.example.handar.ui.onboarding.Onboarding3Fragment"
        android:label="Onboarding 3"
        tools:layout="@layout/fragment_onboarding_3">

        <action android:id="@+id/action_onboarding3_to_survey"
            app:destination="@id/surveyFragment"
            app:popUpTo="@id/onboarding1Fragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/surveyFragment"
        android:name="com.example.handar.ui.survey.SurveyFragment"
        android:label="Khảo sát"
        tools:layout="@layout/fragment_survey">

        <action android:id="@+id/action_survey_to_permission"
            app:destination="@id/permissionFragment"
            app:popUpTo="@id/surveyFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/welcomeFragment"
        android:name="com.example.handar.ui.welcome.WelcomeFragment"
        android:label="Chào mừng"
        tools:layout="@layout/fragment_welcome">

        <action android:id="@+id/action_welcome_to_onboarding_1"
            app:destination="@id/onboarding1Fragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/permissionFragment"
        android:name="com.example.handar.ui.permission.PermissionFragment"
        android:label="Cấp quyền"
        tools:layout="@layout/fragment_permission">

        <action android:id="@+id/action_permission_to_effectList"
            app:destination="@id/effectListFragment"
            app:popUpTo="@id/permissionFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <!-- Mở từ icon hambuger ở view_top_bar.xml. -->
    <fragment android:id="@+id/settingsFragment"
        android:name="com.example.handar.ui.settings.SettingsFragment"
        android:label="Cài đặt"
        tools:layout="@layout/fragment_settings">

        <action android:id="@+id/action_settings_to_language"
            app:destination="@id/languageFragment"/>
    </fragment>

    <fragment android:id="@+id/effectListFragment"
        android:name="com.example.handar.ui.effectlist.EffectListFragment"
        android:label="Chọn hiệu ứng"
        tools:layout="@layout/fragment_effect_list">

        <action android:id="@+id/action_effectList_to_effectPreview"
            app:destination="@id/effectPreviewFragment"/>

        <action android:id="@+id/action_effectList_to_videoList"
            app:destination="@id/videoListFragment"/>
    </fragment>

    <fragment android:id="@+id/cameraRecordFragment"
        android:name="com.example.handar.ui.camera.CameraRecordFragment"
        android:label="Quay video"
        tools:layout="@layout/fragment_camera_record">
        <argument
            android:name="effectId"
            app:argType="string"/>

        <action android:id="@+id/action_cameraRecord_to_recordedPreview"
            app:destination="@id/recordedPreviewFragment"
            app:popUpTo="@id/cameraRecordFragment"
            app:popUpToInclusive="true"/>

        <!-- KHÔNG popUpTo: camera phải nằm lại dưới để nhấn back ở màn chọn thì quay về đúng camera cũ -->
        <action android:id="@+id/action_cameraRecord_to_effectPicker"
            app:destination="@id/effectPickerFragment"/>
    </fragment>

    <fragment android:id="@+id/effectPickerFragment"
        android:name="com.example.handar.ui.effectpicker.EffectPickerFragment"
        android:label="Chọn mẫu"
        tools:layout="@layout/fragment_effect_picker">
        <!-- id effect đang dùng ở camera, để tô viền sẵn. truyền "" nếu chưa có effect nào -->
        <argument
            android:name="currentEffectId"
            app:argType="string"/>

        <!-- tick effect KHÁC → sang màn xem trước effect mới, gỡ cả camera cũ lẫn màn này (camera sẽ được tạo
             mới khi bấm Create). màn này chỉ mở được từ camera nên camera luôn nằm ngay dưới; nếu sau này có đường vào khác
             (camera không nằm dưới) thì popUpTo này im lặng không làm gì (HandAr_Plan.md mục 4). -->
        <action android:id="@+id/action_effectPicker_to_effectPreview"
            app:destination="@id/effectPreviewFragment"
            app:popUpTo="@id/cameraRecordFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/effectPreviewFragment"
        android:name="com.example.handar.ui.effectpreview.EffectPreviewFragment"
        android:label="Xem trước hiệu ứng"
        tools:layout="@layout/fragment_effect_preview">
        <argument
            android:name="effectId"
            app:argType="string"/>

        <!-- Create → camera: popUpTo CHÍNH màn này (màn mình đang rời) inclusive để back ở camera vẫn về
             effectList như trước khi có màn xem trước, và các luồng sau camera (recordedPreview...) không đổi. -->
        <action android:id="@+id/action_effectPreview_to_cameraRecord"
            app:destination="@id/cameraRecordFragment"
            app:popUpTo="@id/effectPreviewFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/recordedPreviewFragment"
        android:name="com.example.handar.ui.recordedpreview.RecordedPreviewFragment"
        android:label="Xem lại"
        tools:layout="@layout/fragment_recorded_preview">
        <argument
            android:name="videoPath"
            app:argType="string"/>
        <!-- chỉ để chuyển tiếp cho share fragment. -->
        <argument
            android:name="effectId"
            app:argType="string"/>

        <action android:id="@+id/action_recordedPreview_to_share"
            app:destination="@id/shareFragment"
            app:popUpTo="@id/recordedPreviewFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/shareFragment"
        android:name="com.example.handar.ui.share.ShareFragment"
        android:label="Chia sẻ"
        tools:layout="@layout/fragment_share">
        <argument
            android:name="videoPath"
            app:argType="string"/>
        <argument
            android:name="effectId"
            app:argType="string"/>
        <!-- chỉ màn đến từ recordedpreview mới hiện nút Try Again; mặc định false cho các lối vào khác (vd từ
             videoPlayerFragment). -->
        <argument
            android:name="fromRecordedPreview"
            app:argType="boolean"
            android:defaultValue="false"/>

        <action android:id="@+id/action_share_to_cameraRecord"
            app:destination="@id/cameraRecordFragment"
            app:popUpTo="@id/shareFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/videoListFragment"
        android:name="com.example.handar.ui.videolist.VideoListFragment"
        android:label="Danh sách video"
        tools:layout="@layout/fragment_video_list">

        <action android:id="@+id/action_videoList_to_videoPlayer"
            app:destination="@id/videoPlayerFragment"/>
    </fragment>

    <fragment android:id="@+id/videoPlayerFragment"
        android:name="com.example.handar.ui.player.VideoPlayerFragment"
        android:label="Phát video"
        tools:layout="@layout/fragment_video_player">
        <argument
            android:name="videoPath"
            app:argType="string"/>

        <!-- không popUpTo: giữ nguyên videoPlayerFragment trong back stack để sau này nếu
             cần back thật (thay vì goHome() như hiện tại) thì vẫn quay đúng về màn này. -->
        <action android:id="@+id/action_videoPlayer_to_share"
            app:destination="@id/shareFragment"/>
    </fragment>
</navigation>