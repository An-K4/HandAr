<?xml version="1.0" encoding="utf-8"?>
<!-- item cho VideoListFragment. dùng lại khung của item_effect.xml
     để đồng bộ phong cách, nhưng đơn giản hơn. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_effect_item_shape"
    android:clipToOutline="true"
    android:foreground="@drawable/border_effect_decorative">

    <ImageView
        android:id="@+id/img_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/video_thumbnail"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/bg_play_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:alpha="0.45"
        android:background="@drawable/bg_play_button_circle" />

    <ImageView
        android:id="@+id/icon_play"
        android:layout_width="22dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_play" />

</FrameLayout>
