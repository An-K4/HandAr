<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_camera_record"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.camera.CameraRecordFragment">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.example.handar.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/layout_camera_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:contentDescription="@string/back"
            android:scaleType="fitStart"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/text_effect_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="@color/black"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_camera_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_recording_timer"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/recording_timer_default"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- hàng thao tác dưới cùng: [effect] [record] [action].
             - mỗi cột là khối dọc: [nhãn ma] [nút viền] [nhãn thật]. nhãn ma (invisible, cùng chữ + cùng cỡ
               với nhãn thật) để khối đối xứng trên/dưới nút.
               nếu đổi chữ hay cỡ chữ nhãn thì phải đổi cả 2 nhãn như nhau.
             - nhãn nằm trong luồng layout bình thường (wrap_content) nên không bao giờ bị cắt.
             - khi đang ghi hình, 2 cột bên được set INVISIBLE (không phải GONE) để vẫn giữ chỗ, nút record không bị
               lệch khỏi vị trí giữa. -->
        <LinearLayout
            android:id="@+id/layout_camera_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:id="@+id/layout_camera_effect_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/camera_effect"
                        android:textSize="10sp"
                        android:visibility="invisible" />

                    <FrameLayout
                        android:id="@+id/btn_effect"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_camera_effect_button"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:contentDescription="@string/camera_effect"
                        android:focusable="true"
                        android:foreground="@drawable/border_camera_button">

                        <ImageView
                            android:id="@+id/img_effect_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/effect_thumbnail"
                            android:scaleType="centerCrop" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="@color/black"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/camera_effect"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_toggle_record"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/ic_record"
                android:clickable="true"
                android:contentDescription="@string/record_button"
                android:elevation="4dp"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/layout_camera_action_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/camera_action"
                        android:textSize="10sp"
                        android:visibility="invisible" />

                    <FrameLayout
                        android:id="@+id/btn_action"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_camera_action_button"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:contentDescription="@string/camera_action"
                        android:focusable="true"
                        android:foreground="@drawable/border_camera_button">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_action" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="@color/black"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/camera_action"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
