<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp 1: Nền hình tròn màu trắng -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <!-- Thêm viền xám nhẹ nếu muốn nút nổi bật trên nền trắng -->
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" />
        </shape>
    </item>

    <item
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp"
        android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="#FF0000" />
        </shape>
    </item>
</layer-list>
